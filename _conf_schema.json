        },
        "default": 180
      }
    }
  },
  "ai_poke_marker": {
    "description": "AI戳一戳暗号标记",
    "hint": "注入给 AI 的暗号：AI 在回复末尾输出该标记表示“我想戳一下对方”，插件会自动剥离标记并执行戳一戳。普通情况下不要修改",
    "type": "string",
    "default": "[戳一戳]"
  },
  "ai_poke_delay": {
    "description": "AI戳一戳延迟（秒）",
    "hint": "AI 决定戳一戳后，等待文字回复先发出、再执行戳一戳的延迟时间",
    "type": "float",
    "slider": {
      "min": 0.5,
      "max": 10,
      "step": 0.5
    },
    "default": 1.5
  }
}
